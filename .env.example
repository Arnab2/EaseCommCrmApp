NODE_ENV=development
PORT=3000

# Local PostgreSQL values. Copy this file to .env and adjust as needed.
DATABASE_URL=postgresql://courier_app:courier_local_password@localhost:5432/ease_courier
DATABASE_SSL=false
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_RETRY_ATTEMPTS=5
DB_RETRY_DELAY_MS=3000

# Generate a unique secret for each environment; never use this placeholder as-is.
API_KEY_PEPPER=replace-with-a-random-secret-of-at-least-32-chars

# Redis and bounded bulk order processing.
REDIS_URL=redis://localhost:6379
# Concurrent bulk jobs per app instance; all courier partners share this limit.
BULK_WORKER_CONCURRENCY=10
BULK_OUTBOX_POLL_INTERVAL_MS=1000
BULK_OUTBOX_BATCH_SIZE=50
BULK_OUTBOX_LEASE_MS=30000
BULK_ITEM_STALE_AFTER_MS=900000

# UrbaneBolt is not registered as a supported courier until enabled.
URBANEBOLT_ENABLED=false
URBANEBOLT_BASE_URL=https://uat.urbanebolt.in
URBANEBOLT_USERNAME=
URBANEBOLT_PASSWORD=
URBANEBOLT_CUSTOMER_CODE=
URBANEBOLT_TOKEN_REFRESH_BUFFER_SECONDS=60
URBANEBOLT_TIMEZONE_OFFSET_MINUTES=330

# Shared HTTP timeout and retry policy. Retries apply only to safe operations.
COURIER_TIMEOUT_MS=10000
COURIER_MAX_RETRIES=3
COURIER_RETRY_BASE_DELAY_MS=500
COURIER_RETRY_MAX_DELAY_MS=5000
