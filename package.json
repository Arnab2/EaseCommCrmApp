{
  "name": "easecommerce-multi-courier-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Courier-agnostic shipment integration API for EaseCommerce",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:migrate": "npm run build && typeorm migration:run -d dist/database/data-source.js",
    "auth:provision": "node scripts/provision-api-client.mjs"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.21.0",
    "bullmq": "^6.6.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "joi": "^17.13.3",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
